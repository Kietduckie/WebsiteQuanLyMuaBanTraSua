@using System.Web.Script.Serialization

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - MilkTea Store</title>
    <!-- Bootstrap 4 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.1/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.min.js"></script>
    <style>
        :root {
            --bg: #F7F2E6;
            --text: #574C50;
            --heading: #574C50;
            --muted: #8A8379;
            --link: #B5624A;
            --link-hover: #8F4A37;
            --accent: #E8C45F;
            --on-accent: #574C50;
            --accent-2: #BC6A52;
            --on-accent-2: #FFFFFF;
            --nav-bg: #FBFAF3;
            --nav-text: #574C50;
            --brand: #BC6A52;
            --card-bg: #FBFAF3;
            --border: #E1E4D3;
            --side-title-bg: #AEBFB0;
            --side-title-text: #4A3F43;
            --input-bg: #FFFFFF;
            --input-text: #574C50;
            --ring: rgba(188,106,82,.25);
            --stripe: rgba(174,191,176,.18);
            --footer-bg: #574C50;
            --footer-text: #E9E7D8;
            --shadow: rgba(87,76,80,.12);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg);
            background-image: radial-gradient(circle at 8% 0%, rgba(232,196,95,.22), transparent 38%), radial-gradient(circle at 95% 25%, rgba(174,191,176,.30), transparent 40%), radial-gradient(circle at 50% 100%, rgba(188,106,82,.10), transparent 45%);
            background-attachment: fixed;
            color: var(--text);
            font-family: "Segoe UI", Roboto, Arial, sans-serif;
        }

        a {
            color: var(--link);
        }

            a:hover {
                color: var(--link-hover);
                text-decoration: none;
            }

        h1, h2, h3, h4, h5, h6 {
            color: var(--heading);
        }

        .ts-navbar {
            background: linear-gradient(180deg, #FFFDF6, #FAF5E6);
            border-radius: 0 0 12px 12px;
            box-shadow: 0 4px 12px var(--shadow);
            border-bottom: 3px solid var(--accent);
            padding: .55rem 1.5rem;
            z-index: 1030;
        }

            .ts-navbar .navbar-brand {
                color: var(--brand);
                font-weight: 700;
                font-size: 1.35rem;
                background: linear-gradient(90deg, #BC6A52, #D98B4A);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                white-space: nowrap;
            }

            .ts-navbar .nav-link {
                color: var(--nav-text) !important;
                border-radius: 20px;
                padding: .4rem .75rem !important;
                transition: background .2s;
                cursor: pointer;
                white-space: nowrap;
            }

                .ts-navbar .nav-link:hover {
                    background: rgba(232,196,95,.35);
                    color: #8F4A37 !important;
                }

        .dropdown-menu.branch-dropdown-menu {
            width: 390px !important;
            min-width: 390px !important;
            max-width: 92vw;
            border-radius: 14px;
            border: 1px solid var(--border);
            background: #FFFDF8;
            box-shadow: 0 8px 24px var(--shadow);
            padding: 12px 14px;
            margin-top: 8px;
            white-space: normal;
        }

        .branch-item {
            padding: 10px 12px;
            border-radius: 10px;
            border-bottom: 1px dashed var(--border);
            transition: background .2s;
        }

            .branch-item:last-child {
                border-bottom: 0;
            }

            .branch-item:hover {
                background: #F6EBC8;
            }

        .address-pill {
            display: inline-flex;
            align-items: center;
            background: var(--input-bg);
            color: var(--input-text);
            border: 1px solid var(--border);
            border-radius: 20px;
            height: 36px;
            padding: 0 14px;
            font-size: .875rem;
            cursor: pointer;
            transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
            max-width: 240px;
            white-space: nowrap;
        }

            .address-pill:hover {
                border-color: var(--accent);
                box-shadow: 0 0 0 .2rem var(--ring);
            }

            .address-pill .addr-text {
                color: var(--link);
                font-weight: 600;
                overflow: hidden;
                text-overflow: ellipsis;
                margin-left: 4px;
            }

        .search-pill-box {
            display: inline-flex;
            align-items: center;
            background: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            height: 36px;
            padding: 0 6px 0 14px;
            transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
        }

            .search-pill-box:focus-within {
                border-color: var(--accent);
                box-shadow: 0 0 0 .2rem var(--ring);
            }

            .search-pill-box input {
                border: 0 !important;
                background: transparent !important;
                box-shadow: none !important;
                outline: none !important;
                height: 34px;
                font-size: .875rem;
                color: var(--input-text);
                width: 175px;
                padding: 0;
            }

            .search-pill-box .btn-search-inner {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                border: 0;
                background: linear-gradient(135deg, #F0CD6B, #E2B94C);
                color: var(--on-accent);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: .8rem;
                cursor: pointer;
                transition: all .2s;
                flex-shrink: 0;
            }

                .search-pill-box .btn-search-inner:hover {
                    background: linear-gradient(135deg, #C97A5F, #B5624A);
                    color: #FFFFFF;
                }

        .user-profile-trigger {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: .25rem .65rem;
            border-radius: 24px;
            cursor: pointer;
            transition: background .2s;
            white-space: nowrap;
        }

            .user-profile-trigger:hover {
                background: rgba(232,196,95,.3);
            }

        .user-avatar-circle {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #8E54A3;
            color: #FFFFFF;
            font-weight: 700;
            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .user-name-upper {
            font-weight: 700;
            color: #3E3A3B;
            text-transform: uppercase;
            font-size: .92rem;
            letter-spacing: .3px;
        }

        .btn-ts, .btn-primary {
            background: linear-gradient(135deg, #F0CD6B, #E2B94C);
            border: 0;
            color: var(--on-accent);
            font-weight: 600;
            border-radius: 20px;
            padding-left: 1rem;
            padding-right: 1rem;
            box-shadow: 0 2px 6px rgba(226,185,76,.45);
            white-space: nowrap;
        }

            .btn-ts:hover, .btn-primary:hover {
                background: linear-gradient(135deg, #C97A5F, #B5624A);
                color: #fff;
                box-shadow: 0 3px 8px rgba(188,106,82,.4);
            }

        .form-control {
            background: var(--input-bg);
            color: var(--input-text);
            border: 1px solid var(--border);
            border-radius: 20px;
        }

            .form-control:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 .2rem var(--ring);
            }

        #sidebarCol, #mainContentCol {
            transition: all 0.35s ease;
        }

        .ts-side-sticky {
            position: -webkit-sticky;
            position: sticky;
            top: 78px;
            z-index: 1010;
            max-height: calc(100vh - 96px);
            overflow-y: auto;
        }

        .ts-side {
            background: #FFFDF8;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px;
            box-shadow: 0 2px 10px var(--shadow);
        }

            .ts-side .ts-side-title {
                background: linear-gradient(135deg, #AEBFB0, #C9D6C7);
                font-weight: 700;
                border-radius: 8px;
                margin: 6px 0;
                border: 0;
                padding: .6rem 1rem;
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .ts-side .ts-side-title a, .ts-side .ts-side-title span {
                    color: var(--side-title-text);
                    display: inline-block;
                }

            .ts-side .list-group-item:not(.ts-side-title) {
                background: transparent;
                border: 0;
                border-left: 3px solid transparent;
                border-radius: 8px;
                margin-bottom: 2px;
                padding: .55rem 1rem;
                color: var(--text);
                transition: all .15s;
            }

                .ts-side .list-group-item:not(.ts-side-title) a {
                    color: var(--text);
                    display: block;
                    cursor: pointer;
                }

                .ts-side .list-group-item:not(.ts-side-title):hover {
                    background: #F6EBC8;
                    border-left-color: #E8C45F;
                    padding-left: 1.3rem;
                }

                .ts-side .list-group-item:not(.ts-side-title) a:hover {
                    color: #8F4A37;
                }

        .sticky-expand-bar {
            position: -webkit-sticky;
            position: sticky;
            top: 76px;
            z-index: 1020;
            pointer-events: none;
            margin-bottom: 10px;
        }

        .btn-toggle-sidebar {
            pointer-events: auto;
            background: #FFFDF8;
            border: 1.5px solid var(--border);
            color: var(--heading);
            border-radius: 24px;
            padding: 8px 18px;
            font-size: .95rem;
            font-weight: 700;
            box-shadow: 0 4px 12px var(--shadow);
            transition: opacity 0.25s ease, background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-toggle-sidebar.is-collapsed {
                opacity: 0.52;
            }

                .btn-toggle-sidebar.is-collapsed:hover {
                    opacity: 1;
                    background: #F6EBC8;
                    color: #8F4A37;
                    border-color: var(--accent);
                    transform: translateY(-1px);
                    box-shadow: 0 6px 16px var(--shadow);
                }

        .flash-sale-banner {
            background: linear-gradient(135deg, #FFF0F0, #FFE2E2);
            border: 2px dashed #E06D6D;
            border-radius: 14px;
            padding: 1.25rem;
        }

        .card {
            background: #FFFDF8;
            border: 1px solid var(--border);
            border-radius: 14px;
            box-shadow: 0 2px 10px var(--shadow);
        }

            .card:hover {
                box-shadow: 0 6px 16px var(--shadow);
                transform: translateY(-2px);
                transition: all .2s;
            }

        .voucher-ticket {
            border: 1.5px dashed var(--accent-2);
            background: #FFFDF8;
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 12px;
        }

        .ts-footer {
            background: linear-gradient(135deg, #574C50, #6C5C5F);
            color: var(--footer-text);
            border-top: 4px solid #E8C45F;
            border-radius: 0;
            font-size: .95rem;
            margin-left: -15px;
            margin-right: -15px;
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body>
    @{
        string tenTk = null, vaiTro = null, emailTk = null, sdtTk = null;
        int soLuongGio = 0;

        // Xác định xem có đang ở TrangChu hay không để ẩn/hiện thanh tìm kiếm
        string currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
        bool isTrangChu = string.Equals(currentController, "TrangChu", StringComparison.OrdinalIgnoreCase);

        var session = ViewContext.HttpContext.Session;
        var tk = session != null ? session["TaiKhoan"] : null;
        if (tk is string)
        {
            try
            {
                var dict = new JavaScriptSerializer().Deserialize<Dictionary<string, object>>((string)tk);
                foreach (var p in dict)
                {
                    if (p.Key.Equals("name", StringComparison.OrdinalIgnoreCase)) { tenTk = p.Value as string; }
                    if (p.Key.Equals("role", StringComparison.OrdinalIgnoreCase)) { vaiTro = p.Value as string; }
                    if (p.Key.Equals("email", StringComparison.OrdinalIgnoreCase)) { emailTk = p.Value as string; }
                    if (p.Key.Equals("phone", StringComparison.OrdinalIgnoreCase) || p.Key.Equals("sdt", StringComparison.OrdinalIgnoreCase)) { sdtTk = p.Value as string; }
                }
            }
            catch { }
        }
        else if (tk != null)
        {
            foreach (var pr in tk.GetType().GetProperties())
            {
                if (pr.Name.Equals("name", StringComparison.OrdinalIgnoreCase) || pr.Name.Equals("HoTen", StringComparison.OrdinalIgnoreCase)) { tenTk = Convert.ToString(pr.GetValue(tk, null)); }
                if (pr.Name.Equals("role", StringComparison.OrdinalIgnoreCase) || pr.Name.Equals("VaiTro", StringComparison.OrdinalIgnoreCase)) { vaiTro = Convert.ToString(pr.GetValue(tk, null)); }
                if (pr.Name.Equals("email", StringComparison.OrdinalIgnoreCase)) { emailTk = Convert.ToString(pr.GetValue(tk, null)); }
                if (pr.Name.Equals("phone", StringComparison.OrdinalIgnoreCase) || pr.Name.Equals("SDT", StringComparison.OrdinalIgnoreCase)) { sdtTk = Convert.ToString(pr.GetValue(tk, null)); }
            }
        }

        string chuCaiDau = "U";
        if (!string.IsNullOrWhiteSpace(tenTk))
        {
            var parts = tenTk.Trim().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
            chuCaiDau = parts[parts.Length - 1].Substring(0, 1).ToUpper();
        }

        var gio = session != null ? session["GioHang"] : null;
        if (gio is string)
        {
            try
            {
                var arr = new JavaScriptSerializer().DeserializeObject((string)gio) as object[];
                soLuongGio = arr == null ? 0 : arr.Length;
            }
            catch { soLuongGio = 0; }
        }
        else if (gio is System.Collections.ICollection)
        {
            soLuongGio = ((System.Collections.ICollection)gio).Count;
        }

        bool hasFlashSale = false;
        if (ViewBag.HasFlashSale is bool && (bool)ViewBag.HasFlashSale)
        {
            hasFlashSale = true;
        }
        else if (session != null && session["HasFlashSale"] is bool && (bool)session["HasFlashSale"])
        {
            hasFlashSale = true;
        }
    }

    <!-- HEADER -->
    <nav class="navbar navbar-expand-xl navbar-light ts-navbar sticky-top">
        <a class="navbar-brand mr-3" href="@Url.Action("Index", "TrangChu")">MILKTEA STORE</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarMain"
                aria-controls="navbarMain" aria-expanded="false" aria-label="Mở menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <!-- BÊN TRÁI -->
            <ul class="navbar-nav mr-auto align-items-xl-center">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "TrangChu")"><i class="fas fa-home"></i> Trang chủ</a>
                </li>

                <!-- DROPDOWN CHI NHÁNH -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="dropdownChiNhanh" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fas fa-store text-success"></i> Chi nhánh
                    </a>
                    <div class="dropdown-menu branch-dropdown-menu" aria-labelledby="dropdownChiNhanh">
                        <div class="branch-item">
                            <div class="font-weight-bold text-dark">Chi nhánh 1 - Tân Phú (Cơ sở chính)</div>
                            <div class="small text-muted mt-1"><i class="fas fa-map-marker-alt text-danger mr-1"></i> 140 Lê Trọng Tấn, P. Tây Thạnh, Q. Tân Phú, TP.HCM</div>
                            <div class="small text-muted"><i class="fas fa-phone-alt text-primary mr-1"></i> Hotline: 0901 000 001</div>
                            <div class="small text-success font-weight-bold"><i class="far fa-clock mr-1"></i> Mở cửa: 08:00 - 22:00 (Hằng ngày)</div>
                        </div>

                        <div class="branch-item">
                            <div class="font-weight-bold text-dark">Chi nhánh 2 - Quận 1</div>
                            <div class="small text-muted mt-1"><i class="fas fa-map-marker-alt text-danger mr-1"></i> 68 Nguyễn Huệ, P. Bến Nghé, Q. 1, TP.HCM</div>
                            <div class="small text-muted"><i class="fas fa-phone-alt text-primary mr-1"></i> Hotline: 0901 000 002</div>
                            <div class="small text-success font-weight-bold"><i class="far fa-clock mr-1"></i> Mở cửa: 08:30 - 22:30 (Hằng ngày)</div>
                        </div>

                        <div class="branch-item">
                            <div class="font-weight-bold text-dark">Chi nhánh 3 - Quận 10</div>
                            <div class="small text-muted mt-1"><i class="fas fa-map-marker-alt text-danger mr-1"></i> 250 Sư Vạn Hạnh, P. 12, Q. 10, TP.HCM</div>
                            <div class="small text-muted"><i class="fas fa-phone-alt text-primary mr-1"></i> Hotline: 0901 000 003</div>
                            <div class="small text-success font-weight-bold"><i class="far fa-clock mr-1"></i> Mở cửa: 08:00 - 22:00 (Hằng ngày)</div>
                        </div>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#" data-toggle="modal" data-target="#modalVoucher">
                        <i class="fa-solid fa-ticket"></i> Voucher
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "GioHang")">
                        <i class="fas fa-shopping-cart"></i> Giỏ hàng (<span class="badge badge-pill badge-warning">@soLuongGio</span>)
                    </a>
                </li>
            </ul>

            <!-- BÊN PHẢI -->
            <div class="d-flex flex-wrap align-items-center" style="gap: 10px;">
                <div class="address-pill" data-toggle="modal" data-target="#modalDiaChi" title="Bấm để thay đổi địa chỉ giao hàng">
                    <i class="fas fa-map-marker-alt text-danger mr-1"></i>
                    <span class="text-muted">Giao đến:</span>
                    <span class="addr-text" id="displayDiaChi">Chọn địa chỉ...</span>
                </div>

                @* Chỉ hiển thị thanh tìm kiếm món ăn ở Trang Chủ *@
                @if (isTrangChu)
                {
                    using (Html.BeginForm("TimKiem", "SanPham", FormMethod.Get, new { @class = "form-inline my-1 my-xl-0" }))
                    {
                        <div class="search-pill-box">
                            <input type="search" name="tuKhoa" placeholder="Tìm kiếm món yêu thích..." value="@Request.QueryString["tuKhoa"]" />
                            <button class="btn-search-inner" type="submit" title="Tìm kiếm"><i class="fas fa-search"></i></button>
                        </div>
                    }
                }

                @if (tenTk == null)
                {
                    <a class="btn btn-ts btn-sm d-inline-flex align-items-center" style="height: 36px;" href="@Url.Action("DangNhap", "NguoiDung")">
                        <i class="fas fa-sign-in-alt mr-1"></i> Đăng nhập
                    </a>
                }
                else
                {
                    <div class="user-profile-trigger" data-toggle="modal" data-target="#modalTaiKhoan" title="Xem thông tin tài khoản">
                        <span class="user-avatar-circle">@chuCaiDau</span>
                        <span class="user-name-upper">@tenTk.ToUpper()</span>
                    </div>
                }
            </div>
        </div>
    </nav>

    <!-- CONTAINER CHÍNH -->
    <div class="container-fluid px-4">
        <div class="row mt-3">
            @* Chỉ hiển thị khi View con (TrangChu) khai báo @section Sidebar *@
            @if (IsSectionDefined("Sidebar"))
            {
                @RenderSection("Sidebar", required: false)
            }

            <!-- NỘI DUNG CHÍNH -->
            <div class="col-12 @(IsSectionDefined("Sidebar") ? "col-lg-9" : "") ts-content" id="mainContentCol">
                @if (IsSectionDefined("Sidebar"))
                {
                    <div class="sticky-expand-bar d-none" id="expandSidebarBar">
                        <button type="button" class="btn-toggle-sidebar is-collapsed" id="btnShowSidebar" title="Mở danh mục sản phẩm">
                            <i class="fas fa-bars"></i> Danh mục
                        </button>
                    </div>
                }

                @if (hasFlashSale)
                {
                    <div id="flash-sale-section" class="flash-sale-banner mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="text-danger font-weight-bold mb-0"><i class="fas fa-bolt"></i> FLASH SALE ĐANG DIỄN RA</h4>
                            <span class="badge badge-danger px-3 py-2">Số lượng có hạn</span>
                        </div>
                        <p class="text-muted mb-0">Săn ngay các món trà sữa và topping giảm giá cực sốc trong khung giờ vàng!</p>
                    </div>
                }

                <div class="mt-2" id="pageRenderBody">
                    @RenderBody()
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <div class="row ts-footer mt-4 py-4 px-3 text-center">
            <div class="col">
                <h5 class="text-warning font-weight-bold">MILKTEA STORE</h5>
                <p class="mb-1">Website quản lý mua bán trà sữa - Đồ án Lập trình web ASP.NET MVC</p>
                <p class="mb-0"><i class="fas fa-phone-alt"></i> Hotline: 0901 000 001 &nbsp;|&nbsp; <i class="fas fa-envelope"></i> Email: admin@trasua.local &nbsp;|&nbsp; <i class="fas fa-clock"></i> Mở cửa: 8:00 - 22:00</p>
            </div>
        </div>
    </div>

    <!-- MODAL NHẬP ĐỊA CHỈ GIAO HÀNG -->
    <div class="modal fade" id="modalDiaChi" tabindex="-1" role="dialog" aria-labelledby="modalDiaChiLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 16px;">
                <div class="modal-header" style="background: var(--side-title-bg); border-radius: 14px 14px 0 0;">
                    <h5 class="modal-title font-weight-bold" id="modalDiaChiLabel"><i class="fas fa-map-marker-alt text-danger mr-2"></i> Địa Chỉ Giao Hàng</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="inputDiaChi" class="font-weight-bold">Nhập địa chỉ nhận hàng của bạn:</label>
                        <input type="text" class="form-control" id="inputDiaChi" placeholder="Ví dụ: 140 Lê Trọng Tấn, Phường Tây Thạnh..." />
                    </div>
                    <small class="text-muted"><i class="fas fa-info-circle"></i> Địa chỉ này sẽ được tự động áp dụng khi bạn đặt món.</small>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-ts" id="btnSaveDiaChi">Xác nhận địa chỉ</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL THÔNG TIN TÀI KHOẢN -->
    @if (tenTk != null)
    {
        <div class="modal fade" id="modalTaiKhoan" tabindex="-1" role="dialog" aria-labelledby="modalTaiKhoanLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content" style="border-radius: 16px;">
                    <div class="modal-header" style="background: var(--side-title-bg); border-radius: 14px 14px 0 0;">
                        <h5 class="modal-title font-weight-bold" id="modalTaiKhoanLabel"><i class="fas fa-user-circle mr-2"></i> Thông Tin Tài Khoản</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body text-center">
                        <div class="user-avatar-circle mx-auto mb-2" style="width: 64px; height: 64px; font-size: 1.75rem;">@chuCaiDau</div>
                        <h5 class="font-weight-bold mb-1">@tenTk.ToUpper()</h5>
                        <span class="badge badge-pill badge-warning px-3 py-1 mb-3">@(vaiTro == "admin" ? "Quản trị viên" : "Khách hàng thành viên")</span>

                        <div class="text-left bg-light p-3 rounded" style="border: 1px solid var(--border);">
                            <p class="mb-2"><i class="fas fa-envelope text-muted mr-2"></i> <b>Email:</b> @(string.IsNullOrEmpty(emailTk) ? "Chưa cập nhật" : emailTk)</p>
                            <p class="mb-2"><i class="fas fa-phone text-muted mr-2"></i> <b>Số điện thoại:</b> @(string.IsNullOrEmpty(sdtTk) ? "Chưa cập nhật" : sdtTk)</p>
                            <p class="mb-0"><i class="fas fa-map-marker-alt text-muted mr-2"></i> <b>Địa chỉ giao hàng:</b> <span id="modalAccountDiaChi">Chưa thiết lập</span></p>
                        </div>

                        <div class="d-flex flex-wrap justify-content-center mt-3" style="gap: 8px;">
                            @if (vaiTro == "admin")
                            {
                                <a href="@Url.Action("Index", "Admin")" class="btn btn-ts btn-sm"><i class="fas fa-tools mr-1"></i> Trang quản trị</a>
                            }
                            <a href="@Url.Action("LichSuDonHang", "DonHang")" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="fas fa-history mr-1"></i> Lịch sử đơn hàng</a>
                            <a href="@Url.Action("DangXuat", "NguoiDung")" class="btn btn-danger btn-sm rounded-pill"><i class="fas fa-sign-out-alt mr-1"></i> Đăng xuất</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- MODAL KHO VOUCHER -->
    <div class="modal fade" id="modalVoucher" tabindex="-1" role="dialog" aria-labelledby="modalVoucherLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 16px;">
                <div class="modal-header" style="background: var(--side-title-bg); border-radius: 14px 14px 0 0;">
                    <h5 class="modal-title font-weight-bold" id="modalVoucherLabel"><i class="fas fa-ticket-alt text-danger mr-2"></i> Kho Voucher Ưu Đãi</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="voucher-ticket d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="font-weight-bold text-danger mb-1">FREESHIP</h6>
                            <small class="text-muted">Miễn phí vận chuyển cho đơn từ 50.000đ</small>
                        </div>
                        <button type="button" class="btn btn-ts btn-sm btn-save-voucher" data-code="FREESHIP">Lưu mã</button>
                    </div>
                    <div class="voucher-ticket d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="font-weight-bold text-danger mb-1">GIAM20K</h6>
                            <small class="text-muted">Giảm trực tiếp 20.000đ cho đơn từ 100.000đ</small>
                        </div>
                        <button type="button" class="btn btn-ts btn-sm btn-save-voucher" data-code="GIAM20K">Lưu mã</button>
                    </div>
                    <div class="voucher-ticket d-flex justify-content-between align-items-center mb-0">
                        <div>
                            <h6 class="font-weight-bold text-danger mb-1">MEOW15</h6>
                            <small class="text-muted">Giảm 15% tối đa 30.000đ cho thành viên mới</small>
                        </div>
                        <button type="button" class="btn btn-ts btn-sm btn-save-voucher" data-code="MEOW15">Lưu mã</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // 1. Tự động quét các mục / tiêu đề danh mục đang hiện trên trang & đồng bộ vào Sidebar
            function scrollToElementWithOffset($target) {
                if ($target && $target.length) {
                    var offsetTop = $target.offset().top - 125;
                    $('html, body').animate({ scrollTop: Math.max(0, offsetTop) }, 420);
                    return true;
                }
                return false;
            }

            var pageSections = [];
            $('#pageRenderBody').find('h2, h3, h4, h5').not('.card-title, .card-body h4, .card-body h5, .store-intro-overlay h3').each(function (idx) {
                var $heading = $(this);
                if ($heading.is(':hidden') || $heading.closest(':hidden').length > 0) return;

                var clone = $heading.clone();
                clone.find('a, small, .badge').remove();
                var titleText = clone.text().trim();

                if (titleText.length >= 2 && titleText.length <= 55) {
                    var anchorId = $heading.attr('id');
                    if (!anchorId) {
                        anchorId = 'sec-anchor-' + idx;
                        $heading.attr('id', anchorId);
                    }
                    pageSections.push({ title: titleText, id: anchorId, $el: $heading });
                }
            });

            if (pageSections.length > 0) {
                var $dynSection = $('#sidebarDynamicSection');
                $dynSection.removeClass('d-none');
                $.each(pageSections, function (i, sec) {
                    var $li = $('<li class="list-group-item"></li>');
                    var $a = $('<a></a>').attr('href', '#' + sec.id).html(sec.title);
                    $a.on('click', function (e) {
                        e.preventDefault();
                        scrollToElementWithOffset($('#' + sec.id));
                    });
                    $li.append($a);
                    $dynSection.append($li);
                });
            }

            $('#sidebarStaticMenu a[data-cat-title]').on('click', function (e) {
                var catName = $(this).data('cat-title').toLowerCase();
                var matched = null;
                $.each(pageSections, function (i, sec) {
                    if (sec.title.toLowerCase().indexOf(catName) !== -1) {
                        matched = sec;
                        return false;
                    }
                });
                if (matched) {
                    e.preventDefault();
                    scrollToElementWithOffset(matched.$el);
                }
            });

            // 2. Thu gọn / Mở rộng Sidebar
            function collapseSidebar(instant) {
                if (instant) {
                    $('#sidebarCol').hide();
                    $('#mainContentCol').removeClass('col-lg-9').addClass('col-lg-12');
                    $('#expandSidebarBar').removeClass('d-none');
                } else {
                    $('#sidebarCol').fadeOut(220, function () {
                        $('#mainContentCol').removeClass('col-lg-9').addClass('col-lg-12');
                        $('#expandSidebarBar').removeClass('d-none').hide().fadeIn(200);
                    });
                }
                sessionStorage.setItem('sidebarCollapsed', '1');
            }

            function expandSidebar() {
                $('#expandSidebarBar').addClass('d-none');
                $('#mainContentCol').removeClass('col-lg-12').addClass('col-lg-9');
                $('#sidebarCol').fadeIn(250);
                sessionStorage.setItem('sidebarCollapsed', '0');
            }

            if ($('#sidebarCol').length > 0 && sessionStorage.getItem('sidebarCollapsed') === '1') {
                collapseSidebar(true);
            }

            $('#btnHideSidebarInner').click(function () {
                collapseSidebar(false);
            });

            $('#btnShowSidebar').click(function () {
                expandSidebar();
            });

            // 3. Khởi tạo & Lưu Địa chỉ giao hàng
            var savedAddr = localStorage.getItem('userDeliveryAddress');
            if (savedAddr) {
                $('#displayDiaChi').text(savedAddr);
                $('#inputDiaChi').val(savedAddr);
                $('#modalAccountDiaChi').text(savedAddr);
            }

            $('#btnSaveDiaChi').click(function () {
                var newAddr = $('#inputDiaChi').val().trim();
                if (newAddr) {
                    localStorage.setItem('userDeliveryAddress', newAddr);
                    $('#displayDiaChi').text(newAddr);
                    $('#modalAccountDiaChi').text(newAddr);
                } else {
                    localStorage.removeItem('userDeliveryAddress');
                    $('#displayDiaChi').text('Chọn địa chỉ...');
                    $('#modalAccountDiaChi').text('Chưa thiết lập');
                }
                $('#modalDiaChi').modal('hide');
            });

            // 4. Xử lý lưu mã voucher vào localStorage
            $('.btn-save-voucher').each(function () {
                var code = $(this).data('code');
                var saved = JSON.parse(localStorage.getItem('savedVouchers') || '[]');
                if (saved.includes(code)) {
                    $(this).text('Đã lưu').removeClass('btn-ts').addClass('btn-secondary').prop('disabled', true);
                }
            });

            $('.btn-save-voucher').click(function () {
                var btn = $(this);
                var code = btn.data('code');
                var saved = JSON.parse(localStorage.getItem('savedVouchers') || '[]');
                if (!saved.includes(code)) {
                    saved.push(code);
                    localStorage.setItem('savedVouchers', JSON.stringify(saved));
                }
                btn.text('Đã lưu').removeClass('btn-ts').addClass('btn-secondary').prop('disabled', true);
            });

            // 5. Đảm bảo Dropdown Chi nhánh hoạt động mượt mà khi bấm vào
            $('#dropdownChiNhanh').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var $menu = $(this).next('.branch-dropdown-menu');
                $('.dropdown-menu').not($menu).removeClass('show');
                $menu.toggleClass('show');
                $(this).attr('aria-expanded', $menu.hasClass('show'));
            });

            $('.branch-dropdown-menu').on('click', function (e) {
                e.stopPropagation();
            });

            $(document).on('click', function () {
                $('.branch-dropdown-menu').removeClass('show');
                $('#dropdownChiNhanh').attr('aria-expanded', 'false');
            });
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>