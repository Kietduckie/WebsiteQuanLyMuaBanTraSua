@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/LayoutPage.cshtml";
    ViewBag.HideBanner = true;
}

<div class="row justify-content-center my-3 text-left">
    <div class="col-md-8 col-lg-7">
        <div class="card border-0">
            <div class="card-header font-weight-bold text-center">
                🧋 Đăng Nhập Hệ Thống
            </div>
            <div class="card-body p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                @using (Html.BeginForm("DangNhap", "NguoiDung", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="font-weight-bold">Email</label>
                        <input type="email" name="email" class="form-control" placeholder="Nhập email đã đăng ký" required />
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Mật khẩu</label>
                        <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu" required />
                    </div>

                    <button type="submit" class="btn btn-ts btn-block py-2 mt-3">
                        Đăng nhập
                    </button>
                }

                <div class="text-center mt-3">
                    <span class="text-muted">Chưa có tài khoản?</span>
                    <a href="@Url.Action("DangKy", "NguoiDung")" class="font-weight-bold">Đăng ký tài khoản mới</a>
                </div>
            </div>
        </div>
    </div>
</div>