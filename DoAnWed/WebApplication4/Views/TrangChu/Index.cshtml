</div>

<!-- ============================================== -->
<!-- 3. CAM KẾT DỊCH VỤ -->
<!-- ============================================== -->
<div class="row mt-4 mb-3">
    <div class="col-12 col-md-4 mb-3">
        <div class="policy-box">
            <span class="policy-icon">🍃</span>
            <div class="policy-title">100% Trà Tươi Hảo Hạng</div>
            <p class="policy-desc">Chắt lọc từ những búp trà tươi tuyển chọn, đảm bảo an toàn & thanh khiết.</p>
        </div>
    </div>
    <div class="col-12 col-md-4 mb-3">
        <div class="policy-box">
            <span class="policy-icon">🧋</span>
            <div class="policy-title">Topping Nấu Mới Mỗi Ngày</div>
            <p class="policy-desc">Trân châu dẻo bùi, thạch giòn sần sật được nấu mới liên tục trong ngày.</p>
        </div>
    </div>
    <div class="col-12 col-md-4 mb-3">
        <div class="policy-box">
            <span class="policy-icon">🛵</span>
            <div class="policy-title">Giao Hàng Siêu Tốc</div>
            <p class="policy-desc">Đóng gói cẩn thận, giữ trọn độ lạnh và hương vị thơm ngon tận tay bạn.</p>
        </div>
    </div>
</div>
