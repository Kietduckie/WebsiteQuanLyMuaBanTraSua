@section scripts {
    <script>
        $(document).ready(function () {
            var currentIndex = 0;
            var $track = $('#dualBannerTrack');
            var $slides = $('.dual-banner-slide');
            var totalSlides = $slides.length;

            function updateBannerPosition() {
                var visibleCount = window.innerWidth < 768 ? 1 : 2;
                var maxIndex = Math.max(0, totalSlides - visibleCount);
                if (currentIndex > maxIndex) currentIndex = 0;
                if (currentIndex < 0) currentIndex = maxIndex;

                var stepPercent = 100 / visibleCount;
                $track.css('transform', 'translateX(-' + (currentIndex * stepPercent) + '%)');
            }

            $('#btnBannerNext').click(function () {
                var visibleCount = window.innerWidth < 768 ? 1 : 2;
                var maxIndex = Math.max(0, totalSlides - visibleCount);
                currentIndex = (currentIndex >= maxIndex) ? 0 : currentIndex + 1;
                updateBannerPosition();
            });

            $('#btnBannerPrev').click(function () {
                var visibleCount = window.innerWidth < 768 ? 1 : 2;
                var maxIndex = Math.max(0, totalSlides - visibleCount);
                currentIndex = (currentIndex <= 0) ? maxIndex : currentIndex - 1;
                updateBannerPosition();
            });

            $(window).on('resize', updateBannerPosition);

            // Tự động chuyển banner sau mỗi 5s
            var bannerInterval = setInterval(function () {
                var visibleCount = window.innerWidth < 768 ? 1 : 2;
                var maxIndex = Math.max(0, totalSlides - visibleCount);
                currentIndex = (currentIndex >= maxIndex) ? 0 : currentIndex + 1;
                updateBannerPosition();
            }, 5000);

            $('.dual-banner-wrapper').hover(
                function () { clearInterval(bannerInterval); },
                function () {
                    bannerInterval = setInterval(function () {
                        var visibleCount = window.innerWidth < 768 ? 1 : 2;
                        var maxIndex = Math.max(0, totalSlides - visibleCount);
                        currentIndex = (currentIndex >= maxIndex) ? 0 : currentIndex + 1;
                        updateBannerPosition();
                    }, 5000);
                }
            );
        });

        window.addEventListener("error", function (e) {
            var el = e.target;
            if (el && el.tagName === "IMG") {
                var fallback = "@Url.Content("~/Images/TraSuaTruyenThong.jpg")";
                if (el.getAttribute("src") !== fallback) {
                    el.setAttribute("src", fallback);
                }
            }
        }, true);
    </script>
}