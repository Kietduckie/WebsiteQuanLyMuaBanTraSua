        width: 100%;
        height: 175px;
        background: #FAF7F0;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ts-card-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .ts-card:hover .ts-card-img-wrap img {
        transform: scale(1.05);
    }

    .ts-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        z-index: 2;
    }

    .ts-badge-hot {
        background: #E53935;
        color: #FFFFFF;
        box-shadow: 0 2px 6px rgba(229, 57, 53, 0.4);
    }

    .ts-card-body {
        padding: 14px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        text-align: left;
    }

    .ts-category-tag {
        font-size: 0.78rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
        font-weight: 600;
    }

    .ts-product-name {
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 6px;
        line-height: 1.35;
        color: var(--heading);
        height: 2.7em;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .ts-product-name a {
        color: var(--heading);
    }

    .ts-product-name a:hover {
        color: var(--link);
    }

    .ts-product-desc {
        font-size: 0.82rem;
        color: var(--muted);
        line-height: 1.4;
        margin-bottom: 12px;
        height: 2.8em;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .ts-price-box {
        margin-top: auto;
        padding-top: 8px;
        border-top: 1px dashed var(--border);
        display: flex;
        align-items: baseline;
        gap: 8px;
    }

    .ts-current-price {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--brand);
    }

    .ts-card-actions {
        margin-top: 12px;
        display: flex;
        gap: 6px;
    }

    .ts-card-actions .btn {
        font-size: 0.85rem;
        padding: 6px 10px;
        border-radius: 8px;
    }

    /* Category pills */
    .cat-pill {
        background: #FFFFFF;
        border: 1px solid var(--border);
        border-radius: 25px;
        padding: 8px 18px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text);
        font-weight: 600;
        font-size: 0.92rem;
        transition: all 0.2s ease;
        margin: 4px;
        text-decoration: none !important;
    }

    .cat-pill:hover {
        background: var(--accent);
        color: var(--on-accent);
        border-color: var(--accent);
        transform: translateY(-2px);
    }

    /* Policy boxes */
    .policy-box {
        background: #FFFFFF;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 18px 14px;
        text-align: center;
        height: 100%;
        transition: transform 0.2s ease;
    }

    .policy-box:hover {
        transform: translateY(-3px);
    }

    .policy-icon {
        font-size: 2rem;
        margin-bottom: 10px;
        display: inline-block;
    }

    .policy-title {
        font-weight: 700;
        font-size: 0.98rem;
        color: var(--heading);
        margin-bottom: 4px;
    }

    .policy-desc {
        font-size: 0.82rem;
        color: var(--muted);
        margin-bottom: 0;
    }

</style>

