@model WebApplication4.Models.categories

@{
    ViewBag.Title = "Cập nhật danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Cập nhật danh mục #@Model.id</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Edit", "DanhMuc", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.id)

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.name, new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(m => m.name, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Thuộc danh mục cha</label>
                        @Html.DropDownListFor(m => m.parent_category_id, (SelectList)ViewBag.ParentList, "-- Là danh mục gốc --", new { @class = "form-select" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả</label>
                        @Html.TextAreaFor(m => m.description, new { @class = "form-control", rows = "3" })
                    </div>

                    <div class="mb-4 form-check form-switch">
                        @Html.CheckBoxFor(m => m.status, new { @class = "form-check-input", id = "statusSwitch" })
                        <label class="form-check-label fw-semibold" for="statusSwitch">Hiển thị danh mục trên trang bán hàng</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index", "DanhMuc")" class="btn btn-secondary">Quay lại</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Cập nhật
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>